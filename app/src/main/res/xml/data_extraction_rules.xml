<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- app_webview/ is the WebView's data directory: it holds the destiny.gg session cookies (sid,
         rememberme), which must never sign in another device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
